    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilgrim Journal uses the camera so you can take photos to attach to your entries."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에 첨부할 사진을 바로 촬영하기 위해 카메라를 사용합니다."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilgrim Journal uses Face ID to unlock the app lock that protects your private journal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 일기 기록의 앱 잠금을 해제하기 위해 Face ID를 사용합니다."
          }
        }
      }
