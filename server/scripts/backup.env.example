# restic settings for scripts/backup.sh and scripts/restore.sh.
# Copy OUTSIDE the repo and deploy folder, then lock it down:
#   mkdir -p ~/.config/pilgrim-backup && cp scripts/backup.env.example ~/.config/pilgrim-backup/env
#   chmod 600 ~/.config/pilgrim-backup/env
# Placeholders only. Never commit the filled-in file.

# Where the repository lives: a folder in the operator's iCloud Drive on the Mac mini (macOS
# uploads it). Its own folder keeps it apart from personal files. Quoted: the path has spaces.
RESTIC_REPOSITORY="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Pilgrim Server Backup"

# … or Cloudflare R2 (S3 API), with a token that can only read and write this bucket:
# RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/pilgrim-prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Repository password (encrypts everything before it leaves the Mac mini). Keep a copy in the
# operator's password manager: without it the backups cannot be read. Either a file (chmod 600) …
RESTIC_PASSWORD_FILE=~/.config/pilgrim-backup/restic-password
# … or a command, e.g. the login Keychain:
#   security add-generic-password -a "$USER" -s pilgrim-restic -w '<password>'
# RESTIC_PASSWORD_COMMAND="security find-generic-password -a $USER -s pilgrim-restic -w"

# Optional dead-man switch (e.g. healthchecks.io): pinged on success, <url>/fail on failure.
BACKUP_HEALTHCHECK_URL=

# Snapshots are filed under this host name (also what restore.sh looks for).
BACKUP_HOST_TAG=pilgrim-prod
