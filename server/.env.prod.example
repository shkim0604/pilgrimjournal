# Production settings for `make prod` on the Mac mini. Copy to server/.env.prod in the deploy
# folder (`make deploy` never copies or deletes .env.* files), fill in, then `chmod 600 .env.prod`.
# NEVER commit .env.prod. This template holds no real value: secrets are left empty on purpose,
# and the server refuses to start in production while JWT_SECRET or MEDIA_URL_SECRET is missing.
# Names match server/Sources/PilgrimServerCore/Common/AppConfig.swift (design.md "환경 변수").
#
# Generate each secret separately, for example:  openssl rand -hex 32
# Keep a copy of every secret in the operator's password manager (needed to restore elsewhere).

# ---- Postgres container (docker-compose.yml builds DATABASE_URL from these) ----------------
POSTGRES_USER=pilgrim
# Required. Letters and digits only (it is placed inside DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=pilgrim

# ---- Set by docker-compose.yml (DATABASE_URL, HTTP_HOST=0.0.0.0, PORT=3100,
# MEDIA_ROOT=/data/media on the `media` volume). Do not set them here; compose overrides them.

# ---- Server ---------------------------------------------------------------------------------
APP_ENV=production
PUBLIC_BASE_URL=https://pilgrim.delight-house.org
LOG_LEVEL=info
# APP_VERSION is passed by `make deploy` (the deployed commit).

# ---- Secrets (required, 32+ bytes each) -----------------------------------------------------
JWT_SECRET=
# HMAC key of the signed photo URLs. Changing it invalidates photo URLs already handed out
# (they expire after 10 minutes anyway).
MEDIA_URL_SECRET=
# X-Admin-Token for /internal/admin/v1. The admin console (web/admin/.env) needs the same value.
# Empty disables the operator routes.
ADMIN_API_TOKEN=

# ---- Switches -------------------------------------------------------------------------------
# Must stay false in production (the server refuses to start otherwise).
DEV_LOGIN_ENABLED=false
# Release default is false: everyone counts as subscribed (docs/group-server.md "구독").
SUBSCRIPTION_REQUIRED=false
# Must be 86400 in production.
TIME_SCALE_DAY_SECONDS=86400
# Oldest app version allowed (X-Pilgrim-Client), for example 1.2.0; empty = no minimum.
MIN_CLIENT_VERSION=
# Optional: new reports post {"text": "새 신고 <reason> (<targetType>)"} (no content) here.
REPORT_WEBHOOK_URL=

# ---- Apple keys (developer.apple.com › Certificates, Identifiers & Profiles › Keys).
# .p8 contents go on one line with \n between lines:
#   awk 'NF {printf "%s\\n", $0}' AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=
# Sign in with Apple key, enabled for the primary App ID com.dhouse.PilgrimJournal.
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
# 32 bytes as base64 or 64 hex characters: openssl rand -hex 32. Losing it makes the stored
# Apple refresh tokens unreadable (account deletion could no longer revoke them).
APPLE_TOKEN_ENC_KEY=
# APNs authentication key (one key serves sandbox and production, both bundle IDs).
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# App Store Connect › Users and Access › Integrations › In-App Purchase key.
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=

# ---- Rate limits: RATE_LIMIT_<NAME>=<requests>/<windowSeconds>. Empty = PilgrimAPI defaults
# (posts 30/3600, comments 120/3600, uploads 60/3600, reactions 300/3600, reports 20/86400,
# invites 30/86400, other 600/600, unauthenticated per IP 30/600).
RATE_LIMIT_POSTS=
RATE_LIMIT_COMMENTS=
RATE_LIMIT_UPLOADS=
RATE_LIMIT_REACTIONS=
RATE_LIMIT_REPORTS=
RATE_LIMIT_INVITES=
RATE_LIMIT_OTHER=
RATE_LIMIT_UNAUTHENTICATED=
