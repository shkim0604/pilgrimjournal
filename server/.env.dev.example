# Development settings for `make dev` (copied to .env.dev on first run; .env.dev is gitignored).
# Every value here is a throwaway development value. Real secrets live only in .env.prod on the
# Mac mini (.env.prod.example) and must never be committed.
# Names match server/Sources/PilgrimServerCore/Common/AppConfig.swift (design.md "환경 변수").

# ---- Postgres container (docker-compose.yml builds DATABASE_URL from these) ----------------
POSTGRES_USER=pilgrim
POSTGRES_PASSWORD=pilgrim
POSTGRES_DB=pilgrim

# ---- Set by docker-compose.yml for the containers; only needed when running the binary
# directly (`swift run PilgrimServer serve` in server/). Values in this file do not override
# the compose ones.
# DATABASE_URL=postgres://pilgrim:pilgrim@127.0.0.1:5433/pilgrim?sslmode=disable
# HTTP_HOST=127.0.0.1
# PORT=3100
# MEDIA_ROOT=./.media

# ---- Server ---------------------------------------------------------------------------------
# development | production | testing
APP_ENV=development
# Public origin for invite links and signed photo URLs, no trailing slash.
PUBLIC_BASE_URL=http://localhost:3100
# Vapor log level: trace, debug, info, notice, warning, error, critical.
LOG_LEVEL=debug
# Reported by GET /api/health (`make deploy` sets it in production).
APP_VERSION=dev

# ---- Secrets (development values; production requires 32+ bytes each) -----------------------
JWT_SECRET=dev-only-jwt-secret-not-for-production-0000
# HMAC key of the signed photo URLs (/api/media-files/<id>?exp&sig).
MEDIA_URL_SECRET=dev-only-media-url-secret-not-for-production
# X-Admin-Token for /internal/admin/v1 (admin console). 32+ bytes; empty disables those routes.
ADMIN_API_TOKEN=dev-only-admin-token-not-for-production-0000

# ---- Switches -------------------------------------------------------------------------------
# POST /api/v1/auth/dev (PILGRIM_DEV_APPLE_USER in the app). Refused when APP_ENV=production.
DEV_LOGIN_ENABLED=true
# Release default is false: everyone counts as subscribed.
SUBSCRIPTION_REQUIRED=false
# One "day" in seconds for expiry, votes, grace periods and invites. 86400 = real days;
# 10 makes a 7-day post disappear after 70 seconds. Refused in production.
TIME_SCALE_DAY_SECONDS=86400
# Oldest app version allowed (X-Pilgrim-Client), for example 1.2.0; empty = no minimum.
MIN_CLIENT_VERSION=
# Optional: new reports post {"text": "새 신고 <reason> (<targetType>)"} here. Empty = off.
REPORT_WEBHOOK_URL=

# ---- Apple keys. Leave empty for dev login only; fill in to try real Sign in with Apple,
# pushes or App Store locally. .p8 contents go on one line with \n between lines:
#   awk 'NF {printf "%s\\n", $0}' AuthKey_XXXXXXXXXX.p8
APPLE_TEAM_ID=
# Sign in with Apple key (code exchange, token revocation).
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
# 32 bytes as base64 or 64 hex characters (`openssl rand -hex 32`); encrypts stored Apple tokens.
APPLE_TOKEN_ENC_KEY=
# APNs key (token-based). Sandbox or production is chosen per device.
APNS_KEY_ID=
APNS_PRIVATE_KEY=
# App Store Server API (In-App Purchase key).
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=

# ---- Rate limits: RATE_LIMIT_<NAME>=<requests>/<windowSeconds>. Empty = PilgrimAPI defaults
# (posts 30/3600, comments 120/3600, uploads 60/3600, reactions 300/3600, reports 20/86400,
# invites 30/86400, other 600/600, unauthenticated per IP 30/600).
RATE_LIMIT_POSTS=
RATE_LIMIT_COMMENTS=
RATE_LIMIT_UPLOADS=
RATE_LIMIT_REACTIONS=
RATE_LIMIT_REPORTS=
RATE_LIMIT_INVITES=
RATE_LIMIT_OTHER=
RATE_LIMIT_UNAUTHENTICATED=
