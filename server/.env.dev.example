# Development settings for `make dev` (copied to .env.dev on first run; .env.dev is gitignored).
# Every value here is a throwaway development value. Real secrets live only in .env.prod on the
# Mac mini (task I1) and must never be committed.

POSTGRES_USER=pilgrim
POSTGRES_PASSWORD=pilgrim
POSTGRES_DB=pilgrim

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3100
LOG_LEVEL=debug

JWT_SECRET=dev-only-jwt-secret-not-for-production-0000
MEDIA_URL_SECRET=dev-only-media-url-secret-not-for-production
ADMIN_API_TOKEN=dev-only-admin-token-not-for-production-0000

# POST /api/v1/auth/dev (PILGRIM_DEV_APPLE_USER in the app). Refused when APP_ENV=production.
DEV_LOGIN_ENABLED=true
# Release default is false: everyone counts as subscribed.
SUBSCRIPTION_REQUIRED=false
# One "day" in seconds for expiry, votes, grace periods and invites. 86400 = real days;
# 10 makes a 7-day post disappear after 70 seconds. Refused in production.
TIME_SCALE_DAY_SECONDS=86400
# Oldest app version allowed (X-Pilgrim-Client); empty = no minimum.
MIN_CLIENT_VERSION=

# Apple / APNs / App Store keys (S1, S5, S8). Leave empty until those tasks need them.
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=
APPLE_TOKEN_ENC_KEY=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
REPORT_WEBHOOK_URL=
