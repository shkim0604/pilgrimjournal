# web/admin/.env 로 복사해서 쓴다. .env 는 커밋하지 않는다.

# 브라우저가 보는 콘솔 주소. POST 요청의 Origin을 이 값과 비교한다.
ADMIN_ORIGIN=https://pilgrim.delight-house.org

# 최초 관리자 계정. 계정이 하나도 없을 때 한 번만 쓰이고, 첫 로그인에서 비밀번호 변경을 강제한다.
# 계정이 생긴 뒤에는 이 값이 무시된다(바꾼 비밀번호가 되돌아가지 않는다).
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin

# Cloudflare 뒤에서 실행할 때 true: CF-Connecting-IP로 로그인 시도 제한을 건다.
TRUST_PROXY=true

# HTTPS가 아닌 로컬 확인(http://localhost)에서만 false.
ADMIN_COOKIE_SECURE=true

# compose의 cloudflared 서비스(--profile tunnel)를 쓸 때만. Zero Trust › Tunnels에서 받은 토큰.
# TUNNEL_TOKEN=

# 대시보드 CI 카드(선택). actions:read 권한의 fine-grained 토큰과 owner/repo.
# GITHUB_TOKEN=
# GITHUB_REPO=
