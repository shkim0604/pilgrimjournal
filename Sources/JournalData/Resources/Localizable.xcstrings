        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t verify the Sign in with Apple user."
          }
        }
      }
    },
    "SwiftData 모델을 Core Data 모델로 변환하지 못했습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
