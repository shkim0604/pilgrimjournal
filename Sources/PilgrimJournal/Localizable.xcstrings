    "날짜" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Date"
          }
        }
      }
    },
    "남은 멤버가 한 명이면 그 사람이 바로 관리자가 되고, 아무도 없으면 그룹이 삭제돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If one member is left, they become the admin right away. If no one is left, the group is deleted."
          }
        }
      }
    },
    "내 iCloud 개인 저장 공간" : {
