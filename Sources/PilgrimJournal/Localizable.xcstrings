    "GROUP_PRAYER_ANSWERED" : {
      "comment" : "Push body: the author marked one of their prayer requests answered; %@ is the author's name",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ marked a prayer answered"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님의 기도제목에 응답이 있어요"
          }
        }
      }
    },
    "‘%@’ 태그를 모든 기록에서 제거할까요?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the tag “%@” from all entries?"
