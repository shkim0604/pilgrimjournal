        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld entry is stored only on this device. You can copy it to separate storage in your current iCloud account, then switch to that storage once the copy is complete."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld entries are stored only on this device. You can copy them to separate storage in your current iCloud account, then switch to that storage once the copy is complete."
