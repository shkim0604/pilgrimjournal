          "stringUnit" : {
            "state" : "translated",
            "value" : "A type named “%@” already exists."
          }
        }
      }
    },
    "기록 %lld개를 옮기지 못했습니다%@. 다음에 앱을 열 때 다시 시도합니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "new",
